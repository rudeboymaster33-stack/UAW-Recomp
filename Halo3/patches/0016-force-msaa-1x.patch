From 25d9f208b2382a1dd152a11f499ea3891f4a19b8 Mon Sep 17 00:00:00 2001
From: UAW Recomp <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 19:13:40 -0400
Subject: [PATCH] gpu: gpu_force_msaa_1x option (render guest MSAA targets
 single-sampled)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 67f6f40..6d0187f 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -71,6 +71,10 @@ REXCVAR_DEFINE_BOOL(vulkan_dynamic_rendering, true, "GPU/Vulkan",
 REXCVAR_DEFINE_BOOL(vulkan_skip_faked_query_draws, true, "GPU",
                     "When occlusion_query_enable is off (results are faked), skip draws made "
                     "inside a guest occlusion query that write no color, depth or stencil");
+REXCVAR_DEFINE_BOOL(gpu_force_msaa_1x, false, "GPU",
+                    "Render guest multisampled (2x/4x MSAA) render targets without MSAA. "
+                    "Much faster on mobile GPUs; edges are less smooth")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
 REXCVAR_DEFINE_BOOL(vulkan_debug_msaa_experiment, false, "GPU",
                     "Diagnostic only (breaks visuals): every 600 frames cycle between normal, "
                     "1x1 scissor and skipped draws in 4x MSAA passes, logged as [gpu-exp]");
@@ -2161,6 +2165,12 @@ void VulkanCommandProcessor::ShutdownContext() {
 }
 
 void VulkanCommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
+  if (index == XE_GPU_REG_RB_SURFACE_INFO && REXCVAR_GET(gpu_force_msaa_1x)) {
+    // Treat every guest render target as single-sampled. Draws and resolves
+    // both read this register, so the EDRAM layout stays self-consistent;
+    // only the anti-aliasing is lost (4x less per-sample work on the host).
+    value &= ~(uint32_t(3) << 16);
+  }
   CommandProcessor::WriteRegister(index, value);
 
   if (index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
-- 
