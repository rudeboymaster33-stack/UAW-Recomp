From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 20:59:04 -0400
Subject: [PATCH] gpu: gpu_collapse_predicated_tiles - draw predicated-tiling
 frames once (first tile stretched over the screen, other tiles skipped)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 include/rex/graphics/command_processor.h | 13 ++++
 include/rex/graphics/util/draw.h         |  6 ++
 src/graphics/command_processor.cpp       | 79 +++++++++++++++++++++++-
 src/graphics/util/draw.cpp               |  8 +++
 4 files changed, 105 insertions(+), 1 deletion(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index da8e432..3df54e8 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -263,6 +263,19 @@ class CommandProcessor {
   uint64_t bin_select_ = 0xFFFFFFFFull;
   uint64_t bin_mask_ = 0xFFFFFFFFull;
 
+  // Predicated tiling collapse (gpu_collapse_predicated_tiles): the first tile
+  // is drawn over the whole screen, the other tiles are skipped.
+  void UpdateTileCollapseState();
+  // Returns true if the draw packet must be skipped.
+  bool TileCollapseBeforeDraw(bool predicated);
+  int32_t tile_index_ = -1;
+  uint64_t tile_last_select_ = 0xFFFFFFFFull;
+  uint32_t tile_height_ = 0;
+  uint32_t tile_full_height_ = 0;
+  uint64_t tile_stat_tiled_frames_ = 0;
+  uint64_t tile_stat_draws_skipped_ = 0;
+  uint64_t tile_stat_scissors_patched_ = 0;
+
   Shader* active_vertex_shader_ = nullptr;
   Shader* active_pixel_shader_ = nullptr;
 
diff --git a/include/rex/graphics/util/draw.h b/include/rex/graphics/util/draw.h
index 3da182d..20f041f 100644
--- a/include/rex/graphics/util/draw.h
+++ b/include/rex/graphics/util/draw.h
@@ -581,6 +581,12 @@ struct ResolveInfo {
 // color render target formats are properly emulated as -32...32, true if
 // emulated as snorm, with range limited to -1...1, but with correct blending
 // within that range.
+// Predicated tiling collapse: while the first tile is drawn over the whole
+// screen, resolves whose rectangle ends at the tile bottom are extended to the
+// full-screen bottom (0 = inactive).
+extern uint32_t g_tile_collapse_tile_bottom;
+extern uint32_t g_tile_collapse_full_bottom;
+
 bool GetResolveInfo(const RegisterFile& regs, const memory::Memory& memory,
                     uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y,
                     bool fixed_rg16_truncated_to_minus_1_to_1,
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 6d628c6..1d2c273 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -22,6 +22,7 @@
 #include <rex/perf/counter.h>
 #include <rex/chrono/clock.h>
 #include <rex/graphics/command_processor.h>
+#include <rex/graphics/util/draw.h>
 #include <rex/graphics/flags.h>
 #include <rex/graphics/graphics_system.h>
 #include <rex/graphics/pipeline/texture/info.h>
@@ -38,6 +39,11 @@
 REXCVAR_DEFINE_BOOL(gpu_debug_ignore_bins, false, "GPU",
                     "Diagnostic: execute predicated packets regardless of the bin select/mask");
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
+REXCVAR_DEFINE_BOOL(gpu_collapse_predicated_tiles, false, "GPU",
+                    "Draw games that use predicated tiling (the screen drawn in strips because "
+                    "of the 10 MB EDRAM) in one pass: the first tile covers the whole screen and "
+                    "the other tiles are skipped (needs the frame to fit, e.g. with MSAA forced "
+                    "to 1x)");
 
 REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
                     "Refresh page-valid state from GPU-written memory at frame end. "
@@ -725,6 +731,63 @@ bool CommandProcessor::ExecutePacketType1(memory::RingBuffer* reader, uint32_t p
   return true;
 }
 
+void CommandProcessor::UpdateTileCollapseState() {
+  if (!REXCVAR_GET(gpu_collapse_predicated_tiles)) {
+    tile_index_ = -1;
+    draw_util::g_tile_collapse_full_bottom = 0;
+    return;
+  }
+  bool tiling = (bin_select_ & 0xFFFFFFFFull) != 0xFFFFFFFFull && bin_select_ != 0;
+  if (!tiling) {
+    tile_index_ = -1;
+    draw_util::g_tile_collapse_full_bottom = 0;
+  } else if (tile_index_ < 0) {
+    tile_index_ = 0;
+    if (++tile_stat_tiled_frames_ >= 120) {
+      REXGPU_INFO("[gpu-tiles] per tiled frame: draws skipped={:.0f} scissors stretched={:.1f} "
+                  "(tile height {}, screen height {})",
+                  double(tile_stat_draws_skipped_) / tile_stat_tiled_frames_,
+                  double(tile_stat_scissors_patched_) / tile_stat_tiled_frames_, tile_height_,
+                  tile_full_height_);
+      tile_stat_tiled_frames_ = 0;
+      tile_stat_draws_skipped_ = 0;
+      tile_stat_scissors_patched_ = 0;
+    }
+  } else if (bin_select_ != tile_last_select_) {
+    ++tile_index_;
+    draw_util::g_tile_collapse_full_bottom = 0;
+  }
+  tile_last_select_ = bin_select_;
+}
+
+bool CommandProcessor::TileCollapseBeforeDraw(bool predicated) {
+  RegisterFile& regs = *register_file_;
+  uint32_t tl = regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL];
+  uint32_t br = regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR];
+  uint32_t tl_y = (tl >> 16) & 0x7FFF;
+  uint32_t br_y = (br >> 16) & 0x7FFF;
+  if (tile_index_ >= 1) {
+    // Learn the tile and screen heights from the tiles that are not drawn.
+    if (br_y < 0x2000 && br_y > tl_y && tl_y > 0) {
+      tile_height_ = br_y - tl_y;
+      tile_full_height_ = std::max(tile_full_height_, br_y);
+    }
+    ++tile_stat_draws_skipped_;
+    return true;
+  }
+  // First tile: stretch the tile scissor over the whole screen.
+  if (tile_height_ && tile_full_height_ > tile_height_ && tl_y == 0 && br_y == tile_height_) {
+    regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR] = (br & ~(UINT32_C(0x7FFF) << 16)) |
+                                                (tile_full_height_ << 16);
+    ++tile_stat_scissors_patched_;
+    draw_util::g_tile_collapse_tile_bottom = tile_height_;
+    draw_util::g_tile_collapse_full_bottom = tile_full_height_;
+  } else if (!(tl_y == 0 && br_y == tile_full_height_)) {
+    draw_util::g_tile_collapse_full_bottom = 0;
+  }
+  return false;
+}
+
 bool CommandProcessor::ExecutePacketType2(memory::RingBuffer* reader, uint32_t packet) {
   // Type-2 packet.
   // No-op. Do nothing.
@@ -743,11 +806,22 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
     return false;
   }
 
+  bool tile_collapse_draw_pass = false;
+  if (tile_index_ >= 0 && (opcode == PM4_DRAW_INDX || opcode == PM4_DRAW_INDX_2)) {
+    if (TileCollapseBeforeDraw((packet & 1) != 0)) {
+      reader->AdvanceRead(count * sizeof(uint32_t));
+      return true;
+    }
+    // In the collapsed first tile, every predicated draw meant for any bin is
+    // needed.
+    tile_collapse_draw_pass = tile_index_ == 0 && bin_mask_ != 0;
+  }
+
   // & 1 == predicate - when set, we do bin check to see if we should execute
   // the packet. Only type 3 packets are affected.
   // We also skip predicated swaps, as they are never valid (probably?).
   if (packet & 1) {
-    bool any_pass = (bin_select_ & bin_mask_) != 0;
+    bool any_pass = (bin_select_ & bin_mask_) != 0 || tile_collapse_draw_pass;
     static uint64_t predicated_total = 0, predicated_skipped = 0;
     ++predicated_total;
     if (!any_pass && opcode != PM4_XE_SWAP) {
@@ -853,11 +927,13 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
     case PM4_SET_BIN_SELECT_LO: {
       uint32_t value = reader->ReadAndSwap<uint32_t>();
       bin_select_ = (bin_select_ & 0xFFFFFFFF00000000ull) | value;
+      UpdateTileCollapseState();
       result = true;
     } break;
     case PM4_SET_BIN_SELECT_HI: {
       uint32_t value = reader->ReadAndSwap<uint32_t>();
       bin_select_ = (bin_select_ & 0xFFFFFFFFull) | (static_cast<uint64_t>(value) << 32);
+      UpdateTileCollapseState();
       result = true;
     } break;
     case PM4_SET_BIN_MASK: {
@@ -872,6 +948,7 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
       uint64_t val_hi = reader->ReadAndSwap<uint32_t>();
       uint64_t val_lo = reader->ReadAndSwap<uint32_t>();
       bin_select_ = (val_hi << 32) | val_lo;
+      UpdateTileCollapseState();
       result = true;
     } break;
     case PM4_CONTEXT_UPDATE: {
diff --git a/src/graphics/util/draw.cpp b/src/graphics/util/draw.cpp
index d11585f..b33c668 100644
--- a/src/graphics/util/draw.cpp
+++ b/src/graphics/util/draw.cpp
@@ -762,6 +762,9 @@ const ResolveCopyShaderInfo resolve_copy_shader_info[size_t(ResolveCopyShaderInd
     {"Resolve Copy Full 128bpp", true, 2, 4, 4, 3},
 };
 
+uint32_t g_tile_collapse_tile_bottom = 0;
+uint32_t g_tile_collapse_full_bottom = 0;
+
 bool GetResolveInfo(const RegisterFile& regs, const memory::Memory& memory,
                     uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y,
                     bool fixed_rg16_truncated_to_minus_1_to_1,
@@ -839,6 +842,11 @@ bool GetResolveInfo(const RegisterFile& regs, const memory::Memory& memory,
   x1 = std::clamp(x1, int32_t(scissor.offset[0]), scissor_right);
   y1 = std::clamp(y1, int32_t(scissor.offset[1]), scissor_bottom);
 
+  if (g_tile_collapse_full_bottom && y0 == 0 && y1 == int32_t(g_tile_collapse_tile_bottom) &&
+      scissor_bottom >= int32_t(g_tile_collapse_full_bottom)) {
+    y1 = int32_t(g_tile_collapse_full_bottom);
+  }
+
   assert_true(x0 <= x1 && y0 <= y1);
 
   // Direct3D 9's D3DDevice_Resolve internally rounds the right/bottom of the
