From 26dad31b1c3cf872589959d71ecb1dd8a211a6d9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 20:34:49 -0400
Subject: [PATCH] spirv: gpu_debug_ps_position_out=* applies to all pixel
 shaders

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/pipeline/shader/spirv_translator_rb.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/graphics/pipeline/shader/spirv_translator_rb.cpp b/src/graphics/pipeline/shader/spirv_translator_rb.cpp
index 0d68769..882c99e 100644
--- a/src/graphics/pipeline/shader/spirv_translator_rb.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator_rb.cpp
@@ -26,7 +26,7 @@
 
 REXCVAR_DEFINE_STRING(gpu_debug_ps_position_out, "", "GPU",
                       "Diagnostic only (breaks visuals): for the listed guest pixel shader hashes, "
-                      "write the pixel position instead of the colors: R = ps_param_gen x / 2048, "
+                      "write the pixel position instead of the colors (* = all shaders): R = ps_param_gen x / 2048, "
                       "G = ps_param_gen y / 2048, B = host FragCoord x / 2048, A = FragCoord y / 2048");
 
 namespace rex::graphics {
@@ -406,8 +406,9 @@ void SpirvShaderTranslator::CompleteFragmentShaderInMain() {
   if (!edram_fragment_shader_interlock_) {
     const std::string& debug_list = REXCVAR_GET(gpu_debug_ps_position_out);
     if (!debug_list.empty() &&
-        debug_list.find(fmt::format("{:016X}", current_shader().ucode_data_hash())) !=
-            std::string::npos) {
+        (debug_list == "*" ||
+         debug_list.find(fmt::format("{:016X}", current_shader().ucode_data_hash())) !=
+             std::string::npos)) {
       spv::Id scale = builder_->makeFloatConstant(1.0f / 2048.0f);
       spv::Id pg_x = const_float_0_, pg_y = const_float_0_;
       uint32_t pg_index = GetPsParamGenInterpolator();
-- 
