From 541ebd4d2ae707dd43ec6b3a6cb6e41a64c6364f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 20:18:54 -0400
Subject: [PATCH] vulkan: [gpu-binds] per-frame pipeline and descriptor set
 bind counts

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 4 ++++
 src/graphics/vulkan/gpu_frame_stats.h     | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 2ad9b05..8b8fba1 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -2422,6 +2422,8 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
       auto fps_now = std::chrono::steady_clock::now();
       double fps_seconds = std::chrono::duration<double>(fps_now - fps_last_time).count();
       fps_last_time = fps_now;
+      REXGPU_INFO("[gpu-binds] per frame: draws={:.0f} pipeline_binds={:.0f} descriptor_set_binds={:.0f}",
+                  st.draws / f, st.pipeline_binds / f, st.descriptor_set_binds / f);
       REXGPU_INFO("[gpu-fps] {:.1f} frames per second ({:.1f} ms per frame)",
                   fps_seconds > 0.0 ? f / fps_seconds : 0.0,
                   fps_seconds * 1000.0 / f);
@@ -4652,6 +4654,7 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
     return draw_fail("pipeline_lookup");
   }
   if (current_guest_graphics_pipeline_ != pipeline) {
+    ++GetGpuFrameStats().pipeline_binds;
     deferred_command_buffer_.CmdVkBindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
     current_guest_graphics_pipeline_ = pipeline;
     current_external_graphics_pipeline_ = VK_NULL_HANDLE;
@@ -7655,6 +7658,7 @@ bool VulkanCommandProcessor::UpdateBindings(const VulkanShader* vertex_shader,
   while (rex::bit_scan_forward(descriptor_sets_remaining, &descriptor_set_index)) {
     uint32_t descriptor_set_mask_tzcnt =
         rex::tzcnt(~(descriptor_sets_remaining | ((UINT32_C(1) << descriptor_set_index) - 1)));
+    ++GetGpuFrameStats().descriptor_set_binds;
     deferred_command_buffer_.CmdVkBindDescriptorSets(
         VK_PIPELINE_BIND_POINT_GRAPHICS,
         current_guest_graphics_pipeline_layout_->GetPipelineLayout(), descriptor_set_index,
diff --git a/src/graphics/vulkan/gpu_frame_stats.h b/src/graphics/vulkan/gpu_frame_stats.h
index f823026..b9fb80f 100644
--- a/src/graphics/vulkan/gpu_frame_stats.h
+++ b/src/graphics/vulkan/gpu_frame_stats.h
@@ -6,6 +6,8 @@
 namespace rex::graphics::vulkan {
 
 struct GpuFrameStats {
+  uint64_t pipeline_binds = 0;
+  uint64_t descriptor_set_binds = 0;
   uint64_t fence_waits = 0;         // blocking vkWaitForFences calls
   uint64_t fence_wait_us = 0;       // time blocked in them
   uint64_t frame_fence_waits = 0;   // ...of which for a free frame slot
-- 
