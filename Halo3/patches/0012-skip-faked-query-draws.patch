From 51fd53df45c5a8b81368059d0268e1610b61c4f4 Mon Sep 17 00:00:00 2001
From: UAW Recomp <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 18:29:39 -0400
Subject: [PATCH] vulkan: skip invisible draws inside faked guest occlusion
 queries

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 .../rex/graphics/vulkan/command_processor.h   |  3 ++
 src/graphics/vulkan/command_processor.cpp     | 45 +++++++++++++++++++
 src/graphics/vulkan/gpu_frame_stats.h         |  6 +++
 3 files changed, 54 insertions(+)

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 174fbfb..e546d89 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -798,6 +798,9 @@ class VulkanCommandProcessor : public CommandProcessor {
   // scissor; when the pass ends, the recorded begin-rendering render area is
   // shrunk to the union, so the GPU loads/stores only that part.
   bool pass_area_bounded_ = false;
+  // A guest occlusion query is open (tracked only while host queries are off,
+  // in which case its result is faked and its invisible draws can be skipped).
+  bool guest_zpd_query_open_ = false;
   size_t pass_begin_args_offset_ = 0;
   VkExtent2D pass_full_extent_ = {};
   int32_t pass_area_x0_ = 0, pass_area_y0_ = 0, pass_area_x1_ = 0, pass_area_y1_ = 0;
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 4bf04ff..d0a5445 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -68,6 +68,9 @@ REXCVAR_DEFINE_BOOL(vulkan_dynamic_rendering, true, "GPU/Vulkan",
                     "Use VK_KHR_dynamic_rendering for Vulkan GPU emulation when supported by the "
                     "device (falls back to render passes otherwise)")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_BOOL(vulkan_skip_faked_query_draws, true, "GPU",
+                    "When occlusion_query_enable is off (results are faked), skip draws made "
+                    "inside a guest occlusion query that write no color, depth or stencil");
 REXCVAR_DEFINE_BOOL(vulkan_gpu_timestamps, false, "GPU",
                     "Profile GPU time per category (passes, transfers, outside-pass work) "
                     "with timestamp queries and log [gpu-time] lines");
@@ -657,6 +660,23 @@ void VulkanCommandProcessor::InitializeShaderStorage(const std::filesystem::path
 bool VulkanCommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* reader,
                                                                 uint32_t packet, uint32_t count) {
   if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_query_resources_available_) {
+    // Track whether a guest query is open (before the base class overwrites
+    // the sample counts with the fake result).
+    const uint32_t kQueryFinishedMarker = rex::byte_swap(0xFFFFFEED);
+    auto* counts = memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(
+        register_file_->values[XE_GPU_REG_RB_SAMPLE_COUNT_ADDR]);
+    if (counts) {
+      bool is_end = counts->ZPass_A == kQueryFinishedMarker ||
+                    counts->ZPass_B == kQueryFinishedMarker ||
+                    counts->ZFail_A == kQueryFinishedMarker ||
+                    counts->ZFail_B == kQueryFinishedMarker;
+      guest_zpd_query_open_ = !is_end;
+      if (!is_end) {
+        ++GetGpuFrameStats().queries;
+      }
+    } else {
+      guest_zpd_query_open_ = false;
+    }
     return CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(reader, packet, count);
   }
 
@@ -2306,6 +2326,11 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
           "shm_uploads={:.1f} shm_upload={:.0f}KB tight_area={:.2f}MPix extents(per frame):{}",
           st.pass_breaks / f, st.buffer_barriers / f, st.image_barriers / f, st.shm_uploads / f,
           st.shm_upload_kb / f, st.tight_area_kpix / f / 1000.0, extents);
+      REXGPU_INFO(
+          "[gpu-query] per frame: queries={:.1f} draws_in_queries={:.1f} skipped={:.1f} "
+          "kept_zwrite={:.1f} kept_color={:.1f} kept_other={:.1f}",
+          st.queries / f, st.query_draws / f, st.query_draws_skipped / f,
+          st.query_draws_zwrite / f, st.query_draws_color / f, st.query_draws_other / f);
       GpuTsLog(f);
       st = GpuFrameStats{};
     }
@@ -4008,6 +4033,26 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   }
   reg::RB_DEPTHCONTROL normalized_depth_control = draw_util::GetNormalizedDepthControl(regs);
 
+  if (guest_zpd_query_open_) {
+    GpuFrameStats& qst = GetGpuFrameStats();
+    ++qst.query_draws;
+    uint32_t query_color_mask =
+        pixel_shader ? draw_util::GetNormalizedColorMask(regs, pixel_shader->writes_color_targets())
+                     : 0;
+    if (normalized_depth_control.z_write_enable) {
+      ++qst.query_draws_zwrite;
+    } else if (query_color_mask) {
+      ++qst.query_draws_color;
+    } else if (normalized_depth_control.stencil_enable || memexport_used_vertex ||
+               memexport_used_pixel) {
+      ++qst.query_draws_other;
+    } else if (REXCVAR_GET(vulkan_skip_faked_query_draws)) {
+      // Only the (faked) sample count could observe this draw.
+      ++qst.query_draws_skipped;
+      return true;
+    }
+  }
+
   uint32_t ps_param_gen_pos = UINT32_MAX;
   uint32_t interpolator_mask =
       pixel_shader ? (vertex_shader->writes_interpolators() &
diff --git a/src/graphics/vulkan/gpu_frame_stats.h b/src/graphics/vulkan/gpu_frame_stats.h
index 6734251..0071ca8 100644
--- a/src/graphics/vulkan/gpu_frame_stats.h
+++ b/src/graphics/vulkan/gpu_frame_stats.h
@@ -22,6 +22,12 @@ struct GpuFrameStats {
   uint64_t image_barriers = 0;
   uint64_t shm_uploads = 0;      // shared memory upload calls that copied data
   uint64_t shm_upload_kb = 0;
+  uint64_t queries = 0;              // guest occlusion queries begun
+  uint64_t query_draws = 0;          // draws issued while a guest query was open
+  uint64_t query_draws_skipped = 0;  // of those, skipped (no visible effect)
+  uint64_t query_draws_zwrite = 0;   // not skipped: depth write on
+  uint64_t query_draws_color = 0;    // not skipped: color writes on
+  uint64_t query_draws_other = 0;    // not skipped: stencil/memexport
   // Render area sizes seen: (width << 16 | height) -> count (first 8 distinct).
   uint32_t extent_keys[8] = {};
   uint64_t extent_counts[8] = {};
-- 
