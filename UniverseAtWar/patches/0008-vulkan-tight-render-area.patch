+void VulkanCommandProcessor::NotePassDrawScissor(const VkRect2D& scissor) {
+  if (!pass_area_bounded_) {
+    return;
+  }
+  pass_area_x0_ = std::min(pass_area_x0_, scissor.offset.x);
+  pass_area_y0_ = std::min(pass_area_y0_, scissor.offset.y);
+  pass_area_x1_ = std::max(pass_area_x1_, int32_t(scissor.offset.x + scissor.extent.width));
+  pass_area_y1_ = std::max(pass_area_y1_, int32_t(scissor.offset.y + scissor.extent.height));
+}
+
+void VulkanCommandProcessor::FinalizePassRenderArea() {
+  if (!pass_area_bounded_) {
+    return;
+  }
+  pass_area_bounded_ = false;
+  if (!REXCVAR_GET(vulkan_tight_render_area)) {
+    return;
+  }
+  int32_t x0 = std::max(pass_area_x0_, 0), y0 = std::max(pass_area_y0_, 0);
+  int32_t x1 = std::min(pass_area_x1_, int32_t(pass_full_extent_.width));
+  int32_t y1 = std::min(pass_area_y1_, int32_t(pass_full_extent_.height));
+  if (x1 <= x0 || y1 <= y0) {
+    return;  // No draws recorded: keep the full area.
+  }
+  VkRect2D area;
+  area.offset.x = x0;
+  area.offset.y = y0;
+  area.extent.width = uint32_t(x1 - x0);
+  area.extent.height = uint32_t(y1 - y0);
+  deferred_command_buffer_.PatchBeginRenderingRenderArea(pass_begin_args_offset_, area);
+  GetGpuFrameStats().tight_area_kpix += uint64_t(area.extent.width) * area.extent.height / 1000;
+}
+
