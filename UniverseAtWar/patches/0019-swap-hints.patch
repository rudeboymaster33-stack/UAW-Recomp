Subject: [PATCH] gpu: swap hints so the game can ask for repeated frames not
 to be shown

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 include/rex/graphics/swap_hints.h         | 16 +++++++++
 src/core/CMakeLists.txt                   |  1 +
 src/core/swap_hints.cpp                   | 42 +++++++++++++++++++++++
 src/graphics/vulkan/command_processor.cpp | 10 ++++++
 4 files changed, 69 insertions(+)
 create mode 100644 include/rex/graphics/swap_hints.h
 create mode 100644 src/core/swap_hints.cpp

diff --git a/include/rex/graphics/swap_hints.h b/include/rex/graphics/swap_hints.h
new file mode 100644
index 0000000..93041e6
--- /dev/null
+++ b/include/rex/graphics/swap_hints.h
@@ -0,0 +1,16 @@
+#pragma once
+// Per-frame hints from game code to the GPU backend's swap handling.
+// The game calls PushGuestSwap once right before each guest VdSwap; the GPU
+// backend calls PopHostSwapPresent once per swap packet it processes (in the
+// same order) to learn whether that frame should actually be shown.
+#include <cstdint>
+
+namespace rex::graphics::swap_hints {
+
+void PushGuestSwap(bool present);
+// Returns false if the game asked for this frame not to be shown.
+bool PopHostSwapPresent();
+// Frames the game asked to skip so far (for logging).
+uint64_t SkippedSwapCount();
+
+}  // namespace rex::graphics::swap_hints
diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index ad4c18c..e77aed6 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -17,6 +17,7 @@ add_library(rexcore OBJECT
     mutex.cpp
     ring_buffer.cpp
     string_buffer.cpp
+    swap_hints.cpp
     threading.cpp
     timer_queue.cpp
     utf8.cpp
diff --git a/src/core/swap_hints.cpp b/src/core/swap_hints.cpp
new file mode 100644
index 0000000..6309e7f
--- /dev/null
+++ b/src/core/swap_hints.cpp
@@ -0,0 +1,42 @@
+#include <rex/graphics/swap_hints.h>
+
+#include <atomic>
+
+namespace rex::graphics::swap_hints {
+namespace {
+constexpr uint64_t kRingSize = 1024;
+std::atomic<uint8_t> g_ring[kRingSize];
+std::atomic<uint64_t> g_pushed{0};
+std::atomic<uint64_t> g_popped{0};
+std::atomic<uint64_t> g_skipped{0};
+}  // namespace
+
+void PushGuestSwap(bool present) {
+  uint64_t index = g_pushed.load(std::memory_order_relaxed);
+  g_ring[index % kRingSize].store(present ? 1 : 0, std::memory_order_relaxed);
+  g_pushed.store(index + 1, std::memory_order_release);
+}
+
+bool PopHostSwapPresent() {
+  uint64_t pushed = g_pushed.load(std::memory_order_acquire);
+  uint64_t popped = g_popped.load(std::memory_order_relaxed);
+  if (popped >= pushed) {
+    // No hint for this swap (game hook not active): show it.
+    return true;
+  }
+  if (pushed - popped > kRingSize / 2) {
+    // Lost track (should not happen): resynchronize and show.
+    g_popped.store(pushed, std::memory_order_relaxed);
+    return true;
+  }
+  bool present = g_ring[popped % kRingSize].load(std::memory_order_relaxed) != 0;
+  g_popped.store(popped + 1, std::memory_order_relaxed);
+  if (!present) {
+    g_skipped.fetch_add(1, std::memory_order_relaxed);
+  }
+  return present;
+}
+
+uint64_t SkippedSwapCount() { return g_skipped.load(std::memory_order_relaxed); }
+
+}  // namespace rex::graphics::swap_hints
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 0eacf56..dc07398 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -89,6 +89,7 @@ REXCVAR_DEFINE_BOOL(vulkan_tight_render_area, true, "GPU",
                     "(large win on tile-based mobile GPUs)");
 
 #include "gpu_frame_stats.h"
+#include <rex/graphics/swap_hints.h>
 #if !defined(_WIN32)
 #include <cxxabi.h>
 #include <dlfcn.h>
@@ -2346,6 +2347,8 @@ GpuFrameStats& GetGpuFrameStats() {
 void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
                                        uint32_t frontbuffer_height) {
   SCOPE_profile_cpu_f("gpu");
+  // Consume this swap's hint first, so every swap packet consumes exactly one.
+  const bool hint_present = rex::graphics::swap_hints::PopHostSwapPresent();
   if (pass_trace_active_) {
     PassTraceFlushDraws();
     pass_trace_active_ = false;
@@ -2426,6 +2429,13 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
     return;
   }
 
+  // The game may ask for frames that only repeat the previous world state not
+  // to be shown (even pacing of what is displayed).
+  if (!hint_present) {
+    EndSubmission(true);
+    return;
+  }
+
   bool skip_present_due_async_placeholder = REXCVAR_GET(async_shader_compilation) &&
                                             REXCVAR_GET(vulkan_async_skip_incomplete_frames) &&
                                             frame_used_async_placeholder_pipeline_;
