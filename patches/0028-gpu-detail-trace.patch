From 0bec5ffa358a092cd0f723cd40dfe76b8e016202 Mon Sep 17 00:00:00 2001
From: Kylie <rudeboymaster33@gmail.com>
Date: Tue, 20 Oct 2026 20:28:45 -0400
Subject: [PATCH] vulkan: detailed one-frame trace of passes, textures, shaders
 and resolves ([gpu-dt])

---
 .../rex/graphics/vulkan/command_processor.h   |  6 ++
 src/graphics/vulkan/command_processor.cpp     | 61 +++++++++++++++++++
 2 files changed, 67 insertions(+)

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index fdb7efe..455ab68 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -16,6 +16,7 @@
 #include <deque>
 #include <functional>
 #include <memory>
+#include <set>
 #include <string>
 #include <string_view>
 #include <unordered_map>
@@ -874,6 +875,11 @@ class VulkanCommandProcessor : public CommandProcessor {
   uint32_t pass_trace_frame_countdown_ = 0;
   std::string pass_trace_;
   uint32_t pass_trace_draws_ = 0;
+  // Detailed one-frame trace ([gpu-dt]): render targets per pass, textures and
+  // pixel shaders used by the draws, and resolve (copy) parameters.
+  std::set<std::string> dtrace_items_;
+  uint32_t dtrace_draws_ = 0;
+  void DTraceFlush();
   void PassTraceFlushDraws();
   void PassTraceAppend(const char* text);
   void NoteBarrierPassBreak();
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index dc07398..3ef7309 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -2356,6 +2356,8 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
     for (size_t pos = 0; pos < pass_trace_.size(); pos += 900) {
       REXGPU_INFO("[gpu-trace] {}", pass_trace_.substr(pos, 900));
     }
+    DTraceFlush();
+    REXGPU_INFO("[gpu-dt] end of frame");
     REXGPU_INFO("[gpu-trace] end of frame");
     pass_trace_.clear();
   }
@@ -3287,6 +3289,18 @@ void VulkanCommandProcessor::SubmitBarriersAndEnterRenderTargetCacheRenderPass(
   if (pass_trace_active_) {
     VulkanRenderTargetCache::RenderPassKey trace_key =
         render_target_cache_->last_update_render_pass_key();
+    {
+      DTraceFlush();
+      const RegisterFile& dregs = *register_file_;
+      REXGPU_INFO("[gpu-dt] PASS {}x{} m{} surf={:08X} c0={:08X} c1={:08X} c2={:08X} c3={:08X} "
+                  "depth={:08X} cmask={:08X} mode={:08X}",
+                  framebuffer->host_extent.width, framebuffer->host_extent.height,
+                  1u << uint32_t(trace_key.msaa_samples), dregs[XE_GPU_REG_RB_SURFACE_INFO],
+                  dregs[XE_GPU_REG_RB_COLOR_INFO], dregs[XE_GPU_REG_RB_COLOR1_INFO],
+                  dregs[XE_GPU_REG_RB_COLOR2_INFO], dregs[XE_GPU_REG_RB_COLOR3_INFO],
+                  dregs[XE_GPU_REG_RB_DEPTH_INFO], dregs[XE_GPU_REG_RB_COLOR_MASK],
+                  dregs[XE_GPU_REG_RB_MODECONTROL]);
+    }
     PassTraceAppend(fmt::format(" [{}x{} m{} u{:X}", framebuffer->host_extent.width,
                                 framebuffer->host_extent.height,
                                 1u << uint32_t(trace_key.msaa_samples),
@@ -3713,6 +3727,25 @@ void VulkanCommandProcessor::PassTraceFlushDraws() {
   }
 }
 
+void VulkanCommandProcessor::DTraceFlush() {
+  if (!dtrace_draws_ && dtrace_items_.empty()) {
+    return;
+  }
+  std::string items;
+  for (const std::string& item : dtrace_items_) {
+    items += ' ';
+    items += item;
+  }
+  for (size_t pos = 0; pos < items.size() || pos == 0; pos += 900) {
+    REXGPU_INFO("[gpu-dt]   draws={}{}", dtrace_draws_, items.substr(pos, 900));
+    if (items.size() <= 900) {
+      break;
+    }
+  }
+  dtrace_draws_ = 0;
+  dtrace_items_.clear();
+}
+
 void VulkanCommandProcessor::PassTraceAppend(const char* text) {
   if (!pass_trace_active_ || pass_trace_.size() > 60000) {
     return;
@@ -4673,6 +4706,22 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   }
   if (pass_trace_active_) {
     ++pass_trace_draws_;
+    ++dtrace_draws_;
+    if (pixel_shader) {
+      dtrace_items_.insert(fmt::format("ps{:016X}", pixel_shader->ucode_data_hash()));
+    }
+    uint32_t dmask = used_texture_mask;
+    while (dmask) {
+      uint32_t ti = uint32_t(__builtin_ctz(dmask));
+      dmask &= dmask - 1;
+      xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(ti);
+      dtrace_items_.insert(fmt::format("t{}:{:08X}/f{}/{}x{}/dim{}/p{}/tl{}/sw{:03X}/x{}", ti,
+                                       uint32_t(f.base_address) << 12, uint32_t(f.format),
+                                       uint32_t(f.size_2d.width) + 1,
+                                       uint32_t(f.size_2d.height) + 1, uint32_t(f.dimension),
+                                       uint32_t(f.pitch), uint32_t(f.tiled),
+                                       uint32_t(f.swizzle), int32_t(f.exp_adjust)));
+    }
   }
   if (gpu_ts_cur_slot_) {
     gpu_ts_slot_verts_[gpu_ts_cur_slot_ - 1] += primitive_processing_result.host_draw_vertex_count;
@@ -4957,6 +5006,18 @@ bool VulkanCommandProcessor::IssueDraw_MemexportReadbackFastPath(uint32_t total_
 bool VulkanCommandProcessor::IssueCopy() {
   ++GetGpuFrameStats().resolves;
   PassTraceAppend(" RESOLVE");
+  if (pass_trace_active_) {
+    DTraceFlush();
+    const RegisterFile& dregs = *register_file_;
+    REXGPU_INFO("[gpu-dt] RESOLVE ctl={:08X} dst={:08X} pitch={:08X} info={:08X} surf={:08X} "
+                "c0={:08X} c1={:08X} depth={:08X} slice={:08X} woff={:08X} br={:08X} tl={:08X}",
+                dregs[XE_GPU_REG_RB_COPY_CONTROL], dregs[XE_GPU_REG_RB_COPY_DEST_BASE],
+                dregs[XE_GPU_REG_RB_COPY_DEST_PITCH], dregs[XE_GPU_REG_RB_COPY_DEST_INFO],
+                dregs[XE_GPU_REG_RB_SURFACE_INFO], dregs[XE_GPU_REG_RB_COLOR_INFO],
+                dregs[XE_GPU_REG_RB_COLOR1_INFO], dregs[XE_GPU_REG_RB_DEPTH_INFO],
+                dregs[XE_GPU_REG_RB_COPY_SURFACE_SLICE], dregs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+                dregs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], dregs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL]);
+  }
 #if XE_GPU_FINE_GRAINED_DRAW_SCOPES
   SCOPE_profile_cpu_f("gpu");
 #endif  // XE_GPU_FINE_GRAINED_DRAW_SCOPES
-- 
2.43.0

