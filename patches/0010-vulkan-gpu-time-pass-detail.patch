From 6362eeb7fcbb624346f36a32a01ba138bdf5ae83 Mon Sep 17 00:00:00 2001
From: UAW Recomp <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 18:08:03 -0400
Subject: [PATCH] vulkan: per pass-type GPU time detail ([gpu-time3])

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 .../rex/graphics/vulkan/command_processor.h   | 13 ++--
 src/graphics/vulkan/command_processor.cpp     | 70 ++++++++++++++-----
 2 files changed, 61 insertions(+), 22 deletions(-)

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index e96e284..174fbfb 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -835,14 +835,19 @@ class VulkanCommandProcessor : public CommandProcessor {
   double gpu_ts_idle_ns_ = 0.0;
   uint64_t gpu_ts_batches_read_ = 0;
   uint64_t gpu_ts_batches_skipped_ = 0;
-  uint32_t gpu_ts_extent_keys_[8] = {};
-  double gpu_ts_extent_ns_[8] = {};
-  uint32_t gpu_ts_extent_passes_[8] = {};
+  static constexpr uint32_t kGpuTsSlots = 16;
+  uint64_t gpu_ts_slot_keys_[kGpuTsSlots] = {};  // (extent << 32) | render pass key.
+  double gpu_ts_slot_ns_[kGpuTsSlots] = {};
+  uint32_t gpu_ts_slot_passes_[kGpuTsSlots] = {};
+  uint64_t gpu_ts_slot_draws_[kGpuTsSlots] = {};
+  uint64_t gpu_ts_slot_area_kpix_[kGpuTsSlots] = {};
+  uint32_t gpu_ts_slot_cpu_passes_[kGpuTsSlots] = {};
+  uint32_t gpu_ts_cur_slot_ = 0;  // 1-based, 0 = not in a tracked draw pass.
   void GpuTsBeginSubmission();
   void GpuTsMark(uint32_t tag);
   void GpuTsEndSubmission();
   void GpuTsCollect();
-  uint32_t GpuTsExtentTag(const VkExtent2D& extent);
+  uint32_t GpuTsExtentTag(const VkExtent2D& extent, uint32_t render_pass_key);
   void GpuTsLog(double frames);
 
   // Currently bound graphics pipeline, either from the pipeline cache (with
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index aa249fb..4bf04ff 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -3164,7 +3164,9 @@ void VulkanCommandProcessor::SubmitBarriersAndEnterRenderTargetCacheRenderPass(
 
   current_render_pass_ = use_dynamic_rendering ? VK_NULL_HANDLE : render_pass;
   current_framebuffer_ = framebuffer;
-  GpuTsMark(kGpuSegDrawPass | GpuTsExtentTag(framebuffer->host_extent));
+  GpuTsMark(kGpuSegDrawPass |
+            GpuTsExtentTag(framebuffer->host_extent,
+                           render_target_cache_->last_update_render_pass_key().key));
   {
     GpuFrameStats& st = GetGpuFrameStats();
     ++st.passes;
@@ -3264,6 +3266,7 @@ void VulkanCommandProcessor::SubmitBarriersAndEnterRenderTargetCacheRenderPass(
 
   current_render_pass_ = use_dynamic_rendering ? VK_NULL_HANDLE : render_pass;
   current_framebuffer_ = framebuffer;
+  gpu_ts_cur_slot_ = 0;
   GpuTsMark(kGpuSegTransferPass);
 
   if (use_dynamic_rendering) {
@@ -3353,6 +3356,9 @@ void VulkanCommandProcessor::FinalizePassRenderArea() {
   if (x1 <= x0 || y1 <= y0) {
     return;  // No draws recorded: keep the full area.
   }
+  if (gpu_ts_cur_slot_) {
+    gpu_ts_slot_area_kpix_[gpu_ts_cur_slot_ - 1] += uint64_t(x1 - x0) * uint64_t(y1 - y0) / 1000;
+  }
   VkRect2D area;
   area.offset.x = x0;
   area.offset.y = y0;
@@ -3362,14 +3368,19 @@ void VulkanCommandProcessor::FinalizePassRenderArea() {
   GetGpuFrameStats().tight_area_kpix += uint64_t(area.extent.width) * area.extent.height / 1000;
 }
 
-uint32_t VulkanCommandProcessor::GpuTsExtentTag(const VkExtent2D& extent) {
+uint32_t VulkanCommandProcessor::GpuTsExtentTag(const VkExtent2D& extent,
+                                                uint32_t render_pass_key) {
+  gpu_ts_cur_slot_ = 0;
   if (gpu_ts_pool_ == VK_NULL_HANDLE) {
     return 0;
   }
-  uint32_t key = (extent.width << 16) | (extent.height & 0xFFFF);
-  for (uint32_t i = 0; i < 8; ++i) {
-    if (gpu_ts_extent_keys_[i] == key || !gpu_ts_extent_keys_[i]) {
-      gpu_ts_extent_keys_[i] = key;
+  uint64_t key = (uint64_t((extent.width << 16) | (extent.height & 0xFFFF)) << 32) |
+                 render_pass_key;
+  for (uint32_t i = 0; i < kGpuTsSlots; ++i) {
+    if (gpu_ts_slot_keys_[i] == key || !gpu_ts_slot_keys_[i]) {
+      gpu_ts_slot_keys_[i] = key;
+      gpu_ts_cur_slot_ = i + 1;
+      ++gpu_ts_slot_cpu_passes_[i];
       return (i + 1) << 8;
     }
   }
@@ -3494,9 +3505,9 @@ void VulkanCommandProcessor::GpuTsCollect() {
             gpu_ts_ns_[cat] += ns;
           }
           uint32_t ext = (tag >> 8) & 0xFF;
-          if (ext >= 1 && ext <= 8) {
-            gpu_ts_extent_ns_[ext - 1] += ns;
-            ++gpu_ts_extent_passes_[ext - 1];
+          if (ext >= 1 && ext <= kGpuTsSlots) {
+            gpu_ts_slot_ns_[ext - 1] += ns;
+            ++gpu_ts_slot_passes_[ext - 1];
           }
         }
         if (gpu_ts_last_submission_ && b.submission == gpu_ts_last_submission_ + 1) {
@@ -3525,22 +3536,41 @@ void VulkanCommandProcessor::GpuTsLog(double frames) {
   for (uint32_t i = 0; i < kGpuSegCount; ++i) {
     busy += gpu_ts_ns_[i];
   }
-  std::string extents;
-  for (uint32_t i = 0; i < 8 && gpu_ts_extent_keys_[i]; ++i) {
-    extents += fmt::format(" {}x{}:{:.2f}ms/{:.1f}", gpu_ts_extent_keys_[i] >> 16,
-                           gpu_ts_extent_keys_[i] & 0xFFFF, gpu_ts_extent_ns_[i] * ms,
-                           gpu_ts_extent_passes_[i] / frames);
-  }
   REXGPU_INFO(
       "[gpu-time] per frame ms: busy={:.2f} outside_passes={:.2f} draw_passes={:.2f} "
       "transfer_passes={:.2f} swap={:.2f} idle_between_submits={:.2f} batches={} skipped={}",
       busy * ms, gpu_ts_ns_[kGpuSegOutside] * ms, gpu_ts_ns_[kGpuSegDrawPass] * ms,
       gpu_ts_ns_[kGpuSegTransferPass] * ms, gpu_ts_ns_[kGpuSegSwapPass] * ms,
       gpu_ts_idle_ns_ * ms, gpu_ts_batches_read_, gpu_ts_batches_skipped_);
-  REXGPU_INFO("[gpu-time2] draw pass ms/passes per frame by size:{}", extents);
+  for (uint32_t i = 0; i < kGpuTsSlots && gpu_ts_slot_keys_[i]; ++i) {
+    if (gpu_ts_slot_cpu_passes_[i] == 0) {
+      continue;
+    }
+    uint32_t ext = uint32_t(gpu_ts_slot_keys_[i] >> 32);
+    VulkanRenderTargetCache::RenderPassKey rpk;
+    rpk.key = uint32_t(gpu_ts_slot_keys_[i]);
+    double cpu_passes = double(gpu_ts_slot_cpu_passes_[i]);
+    REXGPU_INFO(
+        "[gpu-time3] {}x{} msaa={} used=0x{:02X} depth_fmt={} color_fmts={},{},{},{} xfer={}: "
+        "{:.2f}ms/frame passes={:.1f}/frame draws/pass={:.1f} avg_area={:.0f}Kpix "
+        "us/pass={:.0f}",
+        ext >> 16, ext & 0xFFFF, 1u << uint32_t(rpk.msaa_samples), uint32_t(rpk.depth_and_color_used),
+        uint32_t(rpk.depth_format), uint32_t(rpk.color_0_view_format),
+        uint32_t(rpk.color_1_view_format), uint32_t(rpk.color_2_view_format),
+        uint32_t(rpk.color_3_view_format), uint32_t(rpk.color_rts_use_transfer_formats),
+        gpu_ts_slot_ns_[i] * ms, gpu_ts_slot_passes_[i] / frames,
+        gpu_ts_slot_draws_[i] / cpu_passes, gpu_ts_slot_area_kpix_[i] / cpu_passes,
+        gpu_ts_slot_passes_[i] ? gpu_ts_slot_ns_[i] / gpu_ts_slot_passes_[i] / 1000.0 : 0.0);
+  }
   std::fill(std::begin(gpu_ts_ns_), std::end(gpu_ts_ns_), 0.0);
-  std::fill(std::begin(gpu_ts_extent_ns_), std::end(gpu_ts_extent_ns_), 0.0);
-  std::fill(std::begin(gpu_ts_extent_passes_), std::end(gpu_ts_extent_passes_), 0u);
+  std::fill(std::begin(gpu_ts_slot_ns_), std::end(gpu_ts_slot_ns_), 0.0);
+  std::fill(std::begin(gpu_ts_slot_passes_), std::end(gpu_ts_slot_passes_), 0u);
+  std::fill(std::begin(gpu_ts_slot_draws_), std::end(gpu_ts_slot_draws_), uint64_t(0));
+  std::fill(std::begin(gpu_ts_slot_area_kpix_), std::end(gpu_ts_slot_area_kpix_), uint64_t(0));
+  std::fill(std::begin(gpu_ts_slot_cpu_passes_), std::end(gpu_ts_slot_cpu_passes_), 0u);
+  // Fresh slots each period so menu-time pass types do not crowd out battle ones.
+  std::fill(std::begin(gpu_ts_slot_keys_), std::end(gpu_ts_slot_keys_), uint64_t(0));
+  gpu_ts_cur_slot_ = 0;
   gpu_ts_idle_ns_ = 0.0;
   gpu_ts_batches_read_ = 0;
   gpu_ts_batches_skipped_ = 0;
@@ -3560,6 +3590,7 @@ void VulkanCommandProcessor::EndRenderPass() {
   current_render_pass_ = VK_NULL_HANDLE;
   current_framebuffer_ = nullptr;
   in_render_pass_ = false;
+  gpu_ts_cur_slot_ = 0;
   GpuTsMark(kGpuSegOutside);
 }
 
@@ -4411,6 +4442,9 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       render_target_cache_->last_update_render_pass(),
       render_target_cache_->last_update_framebuffer());
   NotePassDrawScissor(dynamic_scissor_);
+  if (gpu_ts_cur_slot_) {
+    ++gpu_ts_slot_draws_[gpu_ts_cur_slot_ - 1];
+  }
 
   // Draw.
   if (primitive_processing_result.index_buffer_type ==
-- 
2.43.0

