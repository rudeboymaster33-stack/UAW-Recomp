From c2406022304bc2e109b9574a4dbf5b5e4d5d96a0 Mon Sep 17 00:00:00 2001
From: Kylie <rudeboymaster33@gmail.com>
Date: Tue, 20 Oct 2026 21:59:08 -0400
Subject: [PATCH] vulkan: [gpu-dt] per-draw primitive/index/shader line in the
 traced frame

---
 include/rex/graphics/vulkan/command_processor.h |  1 +
 src/graphics/vulkan/command_processor.cpp       | 15 +++++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 20d80d8..93f72f1 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -886,6 +886,7 @@ class VulkanCommandProcessor : public CommandProcessor {
   void DTraceSummariseResolves();
   bool gpu_debug_dump_done_ = false;
   uint32_t gpu_debug_traced_frames_ = 0;
+  uint32_t dtrace_draw_lines_ = 0;
   void PassTraceFlushDraws();
   void PassTraceAppend(const char* text);
   void NoteBarrierPassBreak();
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index bab5839..a158a1a 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -2394,6 +2394,7 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
   if (pass_trace_frame_countdown_ && REXCVAR_GET(vulkan_gpu_timestamps)) {
     if (--pass_trace_frame_countdown_ == 0) {
       pass_trace_active_ = true;
+      dtrace_draw_lines_ = 0;
       pass_trace_.clear();
       pass_trace_draws_ = 0;
     }
@@ -4406,6 +4407,20 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
     if (!primitive_processor_->Process(primitive_processing_result)) {
       return draw_fail("primitive_processing");
     }
+    if (pass_trace_active_ && dtrace_draw_lines_ < 1500) {
+      ++dtrace_draw_lines_;
+      const PrimitiveProcessor::ProcessingResult& pr = primitive_processing_result;
+      REXGPU_INFO(
+          "[gpu-dt] DRAW prim={}->{} n={} guest={} host={} ib={} fmt={} reset={} tess={} "
+          "vs={:016X} ps={:016X} t0={:08X} vf0={:08X}",
+          uint32_t(prim_type), uint32_t(pr.host_primitive_type), index_count,
+          pr.guest_draw_vertex_count, pr.host_draw_vertex_count, uint32_t(pr.index_buffer_type),
+          uint32_t(pr.host_index_format), int(pr.host_primitive_reset_enabled),
+          uint32_t(pr.host_vertex_shader_type), vertex_shader->ucode_data_hash(),
+          pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+          uint32_t(regs.GetTextureFetch(0).base_address) << 12,
+          regs.GetVertexFetch(0).address << 2);
+    }
     if (!primitive_processing_result.host_draw_vertex_count) {
       // Nothing to draw.
       return true;
-- 
2.43.0

