+          // Earlier reads and writes of the destination must be done before
+          // the copies overwrite it.
+          VkMemoryBarrier before;
+          before.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+          before.pNext = nullptr;
+          before.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+          before.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+          dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
