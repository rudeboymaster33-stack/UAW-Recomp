+  // Hoist points: a placeholder recorded before a render pass begins. Buffer
+  // copies requested later (while the pass is open) can be attached to it and
+  // are replayed at the placeholder, before the pass, wrapped in barriers.
+  uint32_t CmdHoistPoint() {
+    uint32_t index = uint32_t(hoist_batches_.size());
+    hoist_batches_.emplace_back();
+    auto& args = *reinterpret_cast<ArgsHoistPoint*>(
+        WriteCommand(Command::kHoistPoint, sizeof(ArgsHoistPoint)));
+    args.index = index;
+    return index;
+  }
+  void AddHoistedBufferCopies(uint32_t hoist_index, VkBuffer src_buffer, VkBuffer dst_buffer,
+                              const VkBufferCopy* regions, uint32_t region_count) {
+    if (hoist_index >= hoist_batches_.size()) {
+      return;
+    }
+    HoistBatch& batch = hoist_batches_[hoist_index];
+    for (uint32_t i = 0; i < region_count; ++i) {
+      batch.copies.push_back({src_buffer, dst_buffer, regions[i]});
+    }
+  }
+
   void CmdVkWriteTimestamp(VkPipelineStageFlagBits stage, VkQueryPool query_pool, uint32_t query) {
     auto& args = *reinterpret_cast<ArgsVkWriteTimestamp*>(
         WriteCommand(Command::kVkWriteTimestamp, sizeof(ArgsVkWriteTimestamp)));
