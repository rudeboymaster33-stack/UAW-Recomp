+void VulkanSharedMemory::AddReadRange(std::vector<std::pair<uint32_t, uint32_t>>& list,
+                                      bool& saturated, uint32_t start, uint32_t end) {
+  if (saturated || end <= start) {
+    return;
+  }
+  if (!list.empty()) {
+    // Extend the last range if contiguous / overlapping (common for vertex
+    // data in ring buffers).
+    std::pair<uint32_t, uint32_t>& last = list.back();
+    if (start <= last.second && end >= last.first) {
+      last.first = std::min(last.first, start);
+      last.second = std::max(last.second, end);
+      return;
+    }
+  }
+  if (list.size() >= 1024) {
+    saturated = true;
+    return;
+  }
+  list.emplace_back(start, end);
+}
+
+void VulkanSharedMemory::NoteDrawRead(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  start = std::min(start, kBufferSize);
+  uint32_t end = start + std::min(length, kBufferSize - start);
+  AddReadRange(draw_reads_, draw_reads_saturated_, start, end);
+}
+
+void VulkanSharedMemory::CommitDrawReads() {
+  if (draw_reads_saturated_) {
+    scope_saturated_ = true;
+  }
+  for (const std::pair<uint32_t, uint32_t>& range : draw_reads_) {
+    AddReadRange(scope_reads_, scope_saturated_, range.first, range.second);
+  }
+  draw_reads_.clear();
+  draw_reads_saturated_ = false;
+}
+
+void VulkanSharedMemory::OnRangesRequested(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+    NoteDrawRead(range.first, range.second);
+  }
+}
+
+bool VulkanSharedMemory::ScopeReadsOverlap(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) const {
+  if (scope_saturated_) {
+    return true;
+  }
+  for (const std::pair<uint32_t, uint32_t>& pages : upload_page_ranges) {
+    uint64_t up_start = uint64_t(pages.first) << page_size_log2();
+    uint64_t up_end = uint64_t(pages.first + pages.second) << page_size_log2();
+    for (const std::pair<uint32_t, uint32_t>& read : scope_reads_) {
+      if (uint64_t(read.first) < up_end && up_start < uint64_t(read.second)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
