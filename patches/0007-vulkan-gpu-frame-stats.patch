diff --git a/src/graphics/vulkan/gpu_frame_stats.h b/src/graphics/vulkan/gpu_frame_stats.h
new file mode 100644
index 0000000..4992bb1
--- /dev/null
+++ b/src/graphics/vulkan/gpu_frame_stats.h
@@ -0,0 +1,31 @@
+#pragma once
+// Lightweight per-frame counters for the Vulkan backend (command processor
+// thread only). Logged as [gpu-stats] every 120 guest frames.
+#include <cstdint>
+
+namespace rex::graphics::vulkan {
+
+struct GpuFrameStats {
+  uint64_t draws = 0;
+  uint64_t passes = 0;          // render pass / dynamic rendering begins
+  uint64_t pass_mpixels_x1000 = 0;  // sum of render area (thousand-pixels)
+  uint64_t transfer_passes = 0; // EDRAM ownership transfer passes
+  uint64_t clear_passes = 0;    // resolve clears
+  uint64_t resolves = 0;
+  uint64_t barrier_batches = 0; // SubmitBarriers that issued barriers (ends render pass)
+  uint64_t submissions = 0;
+  uint64_t texture_loads = 0;
+  uint64_t frames = 0;
+  uint64_t pass_breaks = 0;      // barrier batches that had to end an open render pass
+  uint64_t buffer_barriers = 0;
+  uint64_t image_barriers = 0;
+  uint64_t shm_uploads = 0;      // shared memory upload calls that copied data
+  uint64_t shm_upload_kb = 0;
+  // Render area sizes seen: (width << 16 | height) -> count (first 8 distinct).
+  uint32_t extent_keys[8] = {};
+  uint64_t extent_counts[8] = {};
+};
+
+GpuFrameStats& GetGpuFrameStats();
+
+}  // namespace rex::graphics::vulkan
