From 4a5e36c90ff1c90b38990af84c4ce51d54e02216 Mon Sep 17 00:00:00 2001
From: Kylie <rudeboymaster33@gmail.com>
Date: Tue, 20 Oct 2026 21:54:23 -0400
Subject: [PATCH] gpu: count bin-predicated packets ([gpu-bins]) and
 gpu_debug_ignore_bins diagnostic

---
 src/graphics/command_processor.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..6d628c6 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -35,6 +35,8 @@
 #include <rex/system/kernel_state.h>
 #include <rex/system/user_module.h>
 
+REXCVAR_DEFINE_BOOL(gpu_debug_ignore_bins, false, "GPU",
+                    "Diagnostic: execute predicated packets regardless of the bin select/mask");
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
 
 REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
@@ -746,7 +748,17 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
   // We also skip predicated swaps, as they are never valid (probably?).
   if (packet & 1) {
     bool any_pass = (bin_select_ & bin_mask_) != 0;
-    if (!any_pass || opcode == PM4_XE_SWAP) {
+    static uint64_t predicated_total = 0, predicated_skipped = 0;
+    ++predicated_total;
+    if (!any_pass && opcode != PM4_XE_SWAP) {
+      ++predicated_skipped;
+    }
+    if ((predicated_total & 0x3FFF) == 0) {
+      REXGPU_INFO("[gpu-bins] predicated packets: {} total, {} skipped by bin select/mask "
+                  "(select={:016X} mask={:016X})",
+                  predicated_total, predicated_skipped, bin_select_, bin_mask_);
+    }
+    if (opcode == PM4_XE_SWAP || (!any_pass && !REXCVAR_GET(gpu_debug_ignore_bins))) {
       reader->AdvanceRead(count * sizeof(uint32_t));
       return true;
     }
-- 
