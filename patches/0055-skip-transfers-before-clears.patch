+void RenderTargetCache::SkipTransfersBeforeFullClear(
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    const Shader& vertex_shader, const std::pair<uint32_t, uint32_t>* edram_bases_sorted,
+    uint32_t edram_bases_sorted_count, const RenderTargetKey* rt_keys,
+    const uint32_t* rt_lengths_tiles) {
+  const RegisterFile& regs = register_file();
+  bool any_transfers = false;
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    any_transfers |= !last_update_transfers_[i].empty();
+  }
+  if (!any_transfers) {
+    return;
+  }
+  const Shader* pixel_shader = next_draw_pixel_shader_;
+  if (pixel_shader && pixel_shader->kills_pixels()) {
+    return;
+  }
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if (rb_colorcontrol.alpha_test_enable || rb_colorcontrol.alpha_to_mask_enable) {
+    return;
+  }
+  uint32_t overwrite_bits = 0;
+  // Depth and stencil both replaced everywhere.
+  {
+    const reg::RB_DEPTHCONTROL& dc = normalized_depth_control;
+    auto ref_mask = regs.Get<reg::RB_STENCILREFMASK>();
+    reg::RB_STENCILREFMASK ref_mask_bf;
+    ref_mask_bf.value = regs[XE_GPU_REG_RB_STENCILREFMASK_BF];
+    if (dc.z_enable && dc.z_write_enable && dc.zfunc == xenos::CompareFunction::kAlways &&
+        dc.stencil_enable && dc.stencilfunc == xenos::CompareFunction::kAlways &&
+        dc.stencilzpass == xenos::StencilOp::kReplace && ref_mask.stencilwritemask == 0xFF &&
+        (!dc.backface_enable || (dc.stencilfunc_bf == xenos::CompareFunction::kAlways &&
+                                 dc.stencilzpass_bf == xenos::StencilOp::kReplace &&
+                                 ref_mask_bf.stencilwritemask == 0xFF))) {
+      overwrite_bits |= 1;
+    }
+  }
+  if (pixel_shader) {
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (((normalized_color_mask >> (4 * i)) & 0b1111) != 0b1111 ||
+          !pixel_shader->writes_color_target(i)) {
+        continue;
+      }
+      if (regs[reg::RB_BLENDCONTROL::rt_register_indices[i]] != 0x00010001) {
+        continue;
+      }
+      overwrite_bits |= uint32_t(1) << (1 + i);
+    }
+  }
+  if (!overwrite_bits) {
+    return;
+  }
+  int32_t rect_x0, rect_y0, rect_x1, rect_y1;
+  if (!draw_extent_estimator_.EstimateRectangleCoverage(vertex_shader, rect_x0, rect_y0, rect_x1,
+                                                        rect_y1)) {
+    return;
+  }
+  if (rect_x0 > 0 || rect_y0 > 0) {
+    return;
+  }
+  // The window scissor limits what any draw can touch.
+  auto scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  int32_t scissor_x1 = int32_t(scissor_br.br_x), scissor_y1 = int32_t(scissor_br.br_y);
+  if (!scissor_tl.window_offset_disable) {
+    auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    scissor_x1 += window_offset.window_x_offset;
+    scissor_y1 += window_offset.window_y_offset;
+  }
+  for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
+    uint32_t rt_bit_index = edram_bases_sorted[i].second;
+    std::vector<Transfer>& transfers = last_update_transfers_[rt_bit_index];
+    if (transfers.empty() || !(overwrite_bits & (uint32_t(1) << rt_bit_index))) {
+      continue;
+    }
+    const RenderTargetKey& key = rt_keys[rt_bit_index];
+    uint32_t pitch_tiles = key.GetPitchTiles();
+    if (!pitch_tiles) {
+      continue;
+    }
+    int32_t width_px = int32_t(key.pitch_tiles_at_32bpp * xenos::kEdramTileWidthSamples >>
+                               uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X));
+    int32_t rows_px = int32_t(((rt_lengths_tiles[i] + pitch_tiles - 1) / pitch_tiles) *
+                                  xenos::kEdramTileHeightSamples >>
+                              uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X));
+    int32_t need_x1 = std::min(width_px, scissor_x1);
+    int32_t need_y1 = std::min(rows_px, scissor_y1);
+    if (rect_x1 >= need_x1 && rect_y1 >= need_y1) {
+      skipped_clear_transfers_ += transfers.size();
+      transfers.clear();
+    }
+  }
+}
