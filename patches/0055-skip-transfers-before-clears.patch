+namespace {
+class PositionXYExportSink : public ShaderInterpreter::ExportSink {
+ public:
+  void Export(ucode::ExportRegister export_register, const float* value,
+              uint32_t value_mask) override {
+    if (export_register == ucode::ExportRegister::kVSPosition) {
+      if (value_mask & 0b0001) x = value[0];
+      if (value_mask & 0b0010) y = value[1];
+      if (value_mask & 0b1000) w = value[3];
+    } else if (export_register == ucode::ExportRegister::kVSPointSizeEdgeFlagKillVertex) {
+      if (value_mask & 0b0100) {
+        killed = (rex::memory::Reinterpret<uint32_t>(value[2]) & ~(UINT32_C(1) << 31)) != 0;
+      }
+    }
+  }
+  std::optional<float> x, y, w;
+  bool killed = false;
+};
+}  // namespace
+
+bool DrawExtentEstimator::EstimateRectangleCoverage(const Shader& vertex_shader, int32_t& x0,
+                                                    int32_t& y0, int32_t& x1, int32_t& y1) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      vgt_draw_initiator.num_indices != 3 ||
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return false;
+  }
+  if (xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type) &&
+      regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+          xenos::VGTOutputPath::kTessellationEnable) {
+    return false;
+  }
+  if (vertex_shader.type() != xenos::ShaderType::kVertex || !vertex_shader.is_ucode_analyzed() ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float sx = pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE)
+                                              : 1.0f;
+  float ox = pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET)
+                                               : 0.0f;
+  float sy = pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE)
+                                              : 1.0f;
+  float oy = pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET)
+                                               : 0.0f;
+  float min_x = FLT_MAX, min_y = FLT_MAX, max_x = -FLT_MAX, max_y = -FLT_MAX;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionXYExportSink sink;
+  shader_interpreter_.SetExportSink(&sink);
+  bool ok = true;
+  for (uint32_t i = 0; i < 3; ++i) {
+    uint32_t vertex_index =
+        std::min(max_index, std::max(min_index, (i + index_offset) & 0xFFFFFF));
+    sink = PositionXYExportSink();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if (sink.killed || !sink.x.has_value() || !sink.y.has_value()) {
+      ok = false;
+      break;
+    }
+    float vx = sink.x.value(), vy = sink.y.value();
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!sink.w.has_value() || !(sink.w.value() > 0.0f)) {
+        ok = false;
+        break;
+      }
+      vx /= sink.w.value();
+      vy /= sink.w.value();
+    }
+    vx = vx * sx + ox;
+    vy = vy * sy + oy;
+    if (!(vx == vx) || !(vy == vy)) {
+      ok = false;
+      break;
+    }
+    min_x = std::min(min_x, vx);
+    max_x = std::max(max_x, vx);
+    min_y = std::min(min_y, vy);
+    max_y = std::max(max_y, vy);
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!ok) {
+    return false;
+  }
+  // A rectangle list's 3 vertices span the whole rectangle's bounding box.
+  // Covered pixels [x0, x1) x [y0, y1), conservative for both pixel center
+  // conventions (centers at .0 or .5).
+  x0 = int32_t(std::ceil(min_x));
+  y0 = int32_t(std::ceil(min_y));
+  x1 = int32_t(std::ceil(max_x - 0.5f));
+  y1 = int32_t(std::ceil(max_y - 0.5f));
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    x0 += window_offset.window_x_offset;
+    x1 += window_offset.window_x_offset;
+    y0 += window_offset.window_y_offset;
+    y1 += window_offset.window_y_offset;
+  }
+  return x1 > x0 && y1 > y0;
+}
