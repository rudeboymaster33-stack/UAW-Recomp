From 016d767ab1157c43b46fe47bbe07bffc11cad30e Mon Sep 17 00:00:00 2001
From: Kylie <rudeboymaster33@gmail.com>
Date: Tue, 20 Oct 2026 21:41:33 -0400
Subject: [PATCH] vulkan: gpu_debug_dump_resolves - save raw resolve results of
 one traced frame

---
 .../rex/graphics/vulkan/command_processor.h   |  2 ++
 src/graphics/vulkan/command_processor.cpp     | 35 +++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index 8d4f92e..20d80d8 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -884,6 +884,8 @@ class VulkanCommandProcessor : public CommandProcessor {
   // memory contents are summarised at the end of the frame.
   std::vector<std::pair<uint32_t, uint32_t>> dtrace_resolves_;
   void DTraceSummariseResolves();
+  bool gpu_debug_dump_done_ = false;
+  uint32_t gpu_debug_traced_frames_ = 0;
   void PassTraceFlushDraws();
   void PassTraceAppend(const char* text);
   void NoteBarrierPassBreak();
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 6e4acca..bab5839 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -84,6 +84,11 @@ REXCVAR_DEFINE_BOOL(vulkan_debug_msaa_experiment, false, "GPU",
 REXCVAR_DEFINE_STRING(gpu_skip_pixel_shaders, "", "GPU",
                       "Comma-separated hex ucode hashes of guest pixel shaders whose draws are "
                       "skipped (per-game workaround for effects that render incorrectly)");
+REXCVAR_DEFINE_INT32(gpu_debug_dump_frame, 1, "GPU",
+                     "Diagnostic: which traced frame gpu_debug_dump_resolves saves (1 = first)");
+REXCVAR_DEFINE_BOOL(gpu_debug_dump_resolves, false, "GPU",
+                    "Diagnostic: with readback_resolve=full and dump_shaders set, save the raw "
+                    "result of every resolve of the first traced frame to the dump folder");
 REXCVAR_DEFINE_BOOL(gpu_debug_depth_always, false, "GPU",
                     "Diagnostic only (breaks visuals): make every depth test pass");
 REXCVAR_DEFINE_BOOL(gpu_debug_stencil_off, false, "GPU",
@@ -2365,6 +2370,12 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
     }
     DTraceFlush();
     DTraceSummariseResolves();
+    if (REXCVAR_GET(gpu_debug_dump_resolves) && !gpu_debug_dump_done_) {
+      // Dump the Nth traced frame (traced frames come every few seconds).
+      if (++gpu_debug_traced_frames_ >= uint32_t(REXCVAR_GET(gpu_debug_dump_frame))) {
+        gpu_debug_dump_done_ = true;
+      }
+    }
     REXGPU_INFO("[gpu-dt] end of frame");
     REXGPU_INFO("[gpu-trace] end of frame");
     pass_trace_.clear();
@@ -5151,6 +5162,30 @@ bool VulkanCommandProcessor::IssueCopy() {
   }
 
   bool copy_result = IssueCopy_ReadbackResolvePath();
+  if (pass_trace_active_ && readback_mode == ReadbackResolveMode::kFull &&
+      REXCVAR_GET(gpu_debug_dump_resolves) && !REXCVAR_GET(dump_shaders).empty() &&
+      !dtrace_resolves_.empty()) {
+    // Save the raw (tiled) result of each resolve of the first traced frame,
+    // for offline viewing.
+    static uint32_t dumped_frames = 0;
+    static uint32_t dump_seq = 0;
+    static const void* dump_frame_marker = nullptr;
+    (void)dumped_frames;
+    if (!gpu_debug_dump_done_ &&
+        gpu_debug_traced_frames_ + 1 >= uint32_t(REXCVAR_GET(gpu_debug_dump_frame))) {
+      dump_frame_marker = this;
+      const RegisterFile& dregs = *register_file_;
+      auto [daddr, dbytes] = dtrace_resolves_.back();
+      uint32_t dpitch = dregs[XE_GPU_REG_RB_COPY_DEST_PITCH];
+      std::string path = fmt::format(
+          "{}/res_{:03}_{:08X}_{}x{}_info{:08X}.bin", REXCVAR_GET(dump_shaders), dump_seq++, daddr,
+          dpitch & 0x3FFF, (dpitch >> 16) & 0x3FFF, dregs[XE_GPU_REG_RB_COPY_DEST_INFO]);
+      if (FILE* f = std::fopen(path.c_str(), "wb")) {
+        std::fwrite(memory_->TranslatePhysical<const uint8_t*>(daddr & 0x1FFFFFFF), 1, dbytes, f);
+        std::fclose(f);
+      }
+    }
+  }
   if (pass_trace_active_ && readback_mode == ReadbackResolveMode::kFull) {
     // Full readback: guest memory already holds this resolve's result -
     // summarise it now, before later resolves reuse the same memory.
-- 
2.43.0

