From 4be833cf2fa734040b117377d9bfa784000ad824 Mon Sep 17 00:00:00 2001
From: Kylie <rudeboymaster33@gmail.com>
Date: Tue, 20 Oct 2026 21:27:06 -0400
Subject: [PATCH] vulkan: gpu_skip_pixel_shaders - skip draws using listed
 guest pixel shaders (per-game workaround)

---
 src/graphics/vulkan/command_processor.cpp | 32 +++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index d2a86e5..6e4acca 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -81,6 +81,9 @@ REXCVAR_DEFINE_INT32(gpu_force_msaa_1x_pitch, 0, "GPU",
 REXCVAR_DEFINE_BOOL(vulkan_debug_msaa_experiment, false, "GPU",
                     "Diagnostic only (breaks visuals): every 600 frames cycle between normal, "
                     "1x1 scissor and skipped draws in 4x MSAA passes, logged as [gpu-exp]");
+REXCVAR_DEFINE_STRING(gpu_skip_pixel_shaders, "", "GPU",
+                      "Comma-separated hex ucode hashes of guest pixel shaders whose draws are "
+                      "skipped (per-game workaround for effects that render incorrectly)");
 REXCVAR_DEFINE_BOOL(gpu_debug_depth_always, false, "GPU",
                     "Diagnostic only (breaks visuals): make every depth test pass");
 REXCVAR_DEFINE_BOOL(gpu_debug_stencil_off, false, "GPU",
@@ -4293,6 +4296,35 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       return true;
     }
   }
+  if (pixel_shader && !REXCVAR_GET(gpu_skip_pixel_shaders).empty()) {
+    // Skip draws using the listed guest pixel shaders (by ucode hash), as a
+    // per-game workaround for an effect that renders incorrectly.
+    static std::string skip_list_cached;
+    static std::vector<uint64_t> skip_hashes;
+    const std::string& skip_list = REXCVAR_GET(gpu_skip_pixel_shaders);
+    if (skip_list != skip_list_cached) {
+      skip_list_cached = skip_list;
+      skip_hashes.clear();
+      size_t pos = 0;
+      while (pos < skip_list.size()) {
+        size_t comma = skip_list.find(',', pos);
+        std::string item = skip_list.substr(
+            pos, comma == std::string::npos ? std::string::npos : comma - pos);
+        if (!item.empty()) {
+          skip_hashes.push_back(std::strtoull(item.c_str(), nullptr, 16));
+        }
+        if (comma == std::string::npos) {
+          break;
+        }
+        pos = comma + 1;
+      }
+    }
+    for (uint64_t skip_hash : skip_hashes) {
+      if (pixel_shader->ucode_data_hash() == skip_hash) {
+        return true;
+      }
+    }
+  }
   bool memexport_used_pixel = pixel_shader && (pixel_shader->memexport_eM_written() != 0);
   if (memexport_used_pixel) {
     if (!device_properties.fragmentStoresAndAtomics) {
-- 
