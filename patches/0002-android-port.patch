+
+// Saves callee-saved registers into save[], loads them from load[], and
+// returns to the loaded x30 on the loaded stack.
+extern "C" void rex_fiber_swap(uint64_t* save, const uint64_t* load);
+asm(R"(
+  .text
+  .global rex_fiber_swap
+  .hidden rex_fiber_swap
+  .type rex_fiber_swap, %function
+  .p2align 2
+rex_fiber_swap:
+  stp x19, x20, [x0, #0]
+  stp x21, x22, [x0, #16]
+  stp x23, x24, [x0, #32]
+  stp x25, x26, [x0, #48]
+  stp x27, x28, [x0, #64]
+  stp x29, x30, [x0, #80]
+  mov x9, sp
+  str x9, [x0, #96]
+  stp d8, d9, [x0, #104]
+  stp d10, d11, [x0, #120]
+  stp d12, d13, [x0, #136]
+  stp d14, d15, [x0, #152]
+  ldp x19, x20, [x1, #0]
+  ldp x21, x22, [x1, #16]
+  ldp x23, x24, [x1, #32]
+  ldp x25, x26, [x1, #48]
+  ldp x27, x28, [x1, #64]
+  ldp x29, x30, [x1, #80]
+  ldr x9, [x1, #96]
+  mov sp, x9
+  ldp d8, d9, [x1, #104]
+  ldp d10, d11, [x1, #120]
+  ldp d12, d13, [x1, #136]
+  ldp d14, d15, [x1, #152]
+  ret
+  .size rex_fiber_swap, .-rex_fiber_swap
+)");
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  // The context is captured by the first SwitchTo away from this fiber.
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size());
+  top &= ~uintptr_t(15);
+  f->context_[10] = 0;                                              // x29 (frame pointer)
+  f->context_[11] = reinterpret_cast<uint64_t>(&Fiber::Trampoline);  // x30 (return address)
+  f->context_[12] = top;                                            // sp
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must never return (same contract as uc_link == nullptr).
+  __builtin_trap();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_swap(from->context_, target->context_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#elif REX_PLATFORM_LINUX || REX_PLATFORM_MAC
 
 #include <rex/thread/fiber.h>
 
