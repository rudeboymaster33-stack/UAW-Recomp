index c72b132..e96e284 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -804,6 +804,47 @@ class VulkanCommandProcessor : public CommandProcessor {
   void FinalizePassRenderArea();
   void NotePassDrawScissor(const VkRect2D& scissor);
 
+  // GPU timestamp profiling (vulkan_gpu_timestamps): every submission records
+  // timestamps at pass boundaries so GPU time can be split into categories.
+  enum GpuTimeSeg : uint8_t {
+    kGpuSegOutside = 0,  // Barriers, copies, uploads, compute between passes.
+    kGpuSegDrawPass,
+    kGpuSegTransferPass,
+    kGpuSegSwapPass,
+    kGpuSegCount
+  };
+  static constexpr uint32_t kGpuTsPoolSize = 16384;
+  static constexpr uint32_t kGpuTsBatchMax = 2048;
+  struct GpuTsBatch {
+    uint64_t submission;
+    uint32_t first;
+    uint32_t count;
+    std::vector<uint32_t> tags;  // Segment category | (extent key index << 8).
+  };
+  VkQueryPool gpu_ts_pool_ = VK_NULL_HANDLE;
+  bool gpu_ts_init_attempted_ = false;
+  double gpu_ts_period_ns_ = 1.0;
+  uint64_t gpu_ts_valid_mask_ = ~uint64_t(0);
+  uint32_t gpu_ts_ring_next_ = 0;
+  bool gpu_ts_open_ = false;
+  GpuTsBatch gpu_ts_current_;
+  std::deque<GpuTsBatch> gpu_ts_pending_;
+  uint64_t gpu_ts_last_end_ = 0;
+  uint64_t gpu_ts_last_submission_ = 0;
+  double gpu_ts_ns_[kGpuSegCount] = {};
+  double gpu_ts_idle_ns_ = 0.0;
+  uint64_t gpu_ts_batches_read_ = 0;
+  uint64_t gpu_ts_batches_skipped_ = 0;
+  uint32_t gpu_ts_extent_keys_[8] = {};
+  double gpu_ts_extent_ns_[8] = {};
+  uint32_t gpu_ts_extent_passes_[8] = {};
+  void GpuTsBeginSubmission();
+  void GpuTsMark(uint32_t tag);
+  void GpuTsEndSubmission();
+  void GpuTsCollect();
+  uint32_t GpuTsExtentTag(const VkExtent2D& extent);
+  void GpuTsLog(double frames);
+
   // Currently bound graphics pipeline, either from the pipeline cache (with
   // potentially deferred creation - current_external_graphics_pipeline_ is
   // VK_NULL_HANDLE in this case) or a non-Xenos one
