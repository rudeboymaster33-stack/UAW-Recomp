+uint32_t VulkanCommandProcessor::GpuTsExtentTag(const VkExtent2D& extent) {
+  if (gpu_ts_pool_ == VK_NULL_HANDLE) {
+    return 0;
+  }
+  uint32_t key = (extent.width << 16) | (extent.height & 0xFFFF);
+  for (uint32_t i = 0; i < 8; ++i) {
+    if (gpu_ts_extent_keys_[i] == key || !gpu_ts_extent_keys_[i]) {
+      gpu_ts_extent_keys_[i] = key;
+      return (i + 1) << 8;
+    }
+  }
+  return 0;
+}
+
+void VulkanCommandProcessor::GpuTsMark(uint32_t tag) {
+  if (!gpu_ts_open_ || !submission_open_) {
+    return;
+  }
+  GpuTsBatch& b = gpu_ts_current_;
+  // Keep the last slot for the end-of-submission mark.
+  if (b.count + 1 >= kGpuTsBatchMax) {
+    return;
+  }
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_ts_pool_,
+                                               b.first + b.count);
+  b.tags.push_back(tag);
+  ++b.count;
+}
+
+void VulkanCommandProcessor::GpuTsBeginSubmission() {
+  gpu_ts_open_ = false;
+  if (!REXCVAR_GET(vulkan_gpu_timestamps)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  if (!gpu_ts_init_attempted_) {
+    gpu_ts_init_attempted_ = true;
+    const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+    VkPhysicalDeviceProperties props;
+    ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &props);
+    uint32_t family_count = 0;
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(), &family_count,
+                                                 nullptr);
+    std::vector<VkQueueFamilyProperties> families(family_count);
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(), &family_count,
+                                                 families.data());
+    uint32_t family = vulkan_device->queue_family_graphics_compute();
+    uint32_t valid_bits = family < family_count ? families[family].timestampValidBits : 0;
+    if (!valid_bits || props.limits.timestampPeriod <= 0.0f) {
+      REXGPU_WARN("[gpu-time] timestamps not supported on the graphics queue");
+      return;
+    }
+    gpu_ts_valid_mask_ = valid_bits >= 64 ? ~uint64_t(0) : ((uint64_t(1) << valid_bits) - 1);
+    gpu_ts_period_ns_ = props.limits.timestampPeriod;
+    VkQueryPoolCreateInfo pool_info = {};
+    pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    pool_info.queryCount = kGpuTsPoolSize;
+    if (dfn.vkCreateQueryPool(device, &pool_info, nullptr, &gpu_ts_pool_) != VK_SUCCESS) {
+      gpu_ts_pool_ = VK_NULL_HANDLE;
+      REXGPU_WARN("[gpu-time] failed to create the timestamp query pool");
+      return;
+    }
+    REXGPU_INFO("[gpu-time] enabled: period={}ns valid_bits={}", gpu_ts_period_ns_, valid_bits);
+  }
+  if (gpu_ts_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  GpuTsCollect();
+  uint32_t first = gpu_ts_ring_next_;
+  if (first + kGpuTsBatchMax > kGpuTsPoolSize) {
+    first = 0;
+  }
+  for (const GpuTsBatch& p : gpu_ts_pending_) {
+    if (first < p.first + kGpuTsBatchMax && p.first < first + kGpuTsBatchMax) {
+      ++gpu_ts_batches_skipped_;
+      return;
+    }
+  }
+  gpu_ts_ring_next_ = first + kGpuTsBatchMax;
+  gpu_ts_current_.submission = GetCurrentSubmission();
+  gpu_ts_current_.first = first;
+  gpu_ts_current_.count = 0;
+  gpu_ts_current_.tags.clear();
+  deferred_command_buffer_.CmdVkResetQueryPool(gpu_ts_pool_, first, kGpuTsBatchMax);
+  gpu_ts_open_ = true;
+  GpuTsMark(kGpuSegOutside);
+}
+
+void VulkanCommandProcessor::GpuTsEndSubmission() {
+  if (!gpu_ts_open_) {
+    return;
+  }
+  GpuTsBatch& b = gpu_ts_current_;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_ts_pool_,
+                                               b.first + b.count);
+  b.tags.push_back(kGpuSegOutside);
+  ++b.count;
+  gpu_ts_pending_.push_back(std::move(b));
+  gpu_ts_current_ = GpuTsBatch{};
+  gpu_ts_open_ = false;
+}
+
+void VulkanCommandProcessor::GpuTsCollect() {
+  if (gpu_ts_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  std::vector<uint64_t> ts;
+  while (!gpu_ts_pending_.empty() && gpu_ts_pending_.front().submission <= submission_completed_) {
+    GpuTsBatch& b = gpu_ts_pending_.front();
+    if (b.count >= 2) {
+      ts.resize(b.count);
+      VkResult r = dfn.vkGetQueryPoolResults(device, gpu_ts_pool_, b.first, b.count,
+                                             sizeof(uint64_t) * b.count, ts.data(),
+                                             sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+      if (r == VK_SUCCESS) {
+        for (uint32_t i = 0; i + 1 < b.count; ++i) {
+          double ns = double((ts[i + 1] - ts[i]) & gpu_ts_valid_mask_) * gpu_ts_period_ns_;
+          if (ns > 1.0e9) {
+            continue;  // Wraparound or garbage.
+          }
+          uint32_t tag = b.tags[i];
+          uint32_t cat = tag & 0xFF;
+          if (cat < kGpuSegCount) {
+            gpu_ts_ns_[cat] += ns;
+          }
+          uint32_t ext = (tag >> 8) & 0xFF;
+          if (ext >= 1 && ext <= 8) {
+            gpu_ts_extent_ns_[ext - 1] += ns;
+            ++gpu_ts_extent_passes_[ext - 1];
+          }
+        }
+        if (gpu_ts_last_submission_ && b.submission == gpu_ts_last_submission_ + 1) {
+          double idle = double((ts[0] - gpu_ts_last_end_) & gpu_ts_valid_mask_) * gpu_ts_period_ns_;
+          if (idle < 1.0e9) {
+            gpu_ts_idle_ns_ += idle;
+          }
+        }
+        gpu_ts_last_end_ = ts[b.count - 1];
+        gpu_ts_last_submission_ = b.submission;
+        ++gpu_ts_batches_read_;
+      } else {
+        ++gpu_ts_batches_skipped_;
+      }
+    }
+    gpu_ts_pending_.pop_front();
+  }
+}
+
+void VulkanCommandProcessor::GpuTsLog(double frames) {
+  if (gpu_ts_pool_ == VK_NULL_HANDLE || frames <= 0.0) {
+    return;
+  }
+  double ms = 1.0e-6 / frames;
+  double busy = 0.0;
+  for (uint32_t i = 0; i < kGpuSegCount; ++i) {
+    busy += gpu_ts_ns_[i];
+  }
+  std::string extents;
+  for (uint32_t i = 0; i < 8 && gpu_ts_extent_keys_[i]; ++i) {
+    extents += fmt::format(" {}x{}:{:.2f}ms/{:.1f}", gpu_ts_extent_keys_[i] >> 16,
+                           gpu_ts_extent_keys_[i] & 0xFFFF, gpu_ts_extent_ns_[i] * ms,
+                           gpu_ts_extent_passes_[i] / frames);
+  }
+  REXGPU_INFO(
+      "[gpu-time] per frame ms: busy={:.2f} outside_passes={:.2f} draw_passes={:.2f} "
+      "transfer_passes={:.2f} swap={:.2f} idle_between_submits={:.2f} batches={} skipped={}",
+      busy * ms, gpu_ts_ns_[kGpuSegOutside] * ms, gpu_ts_ns_[kGpuSegDrawPass] * ms,
+      gpu_ts_ns_[kGpuSegTransferPass] * ms, gpu_ts_ns_[kGpuSegSwapPass] * ms,
+      gpu_ts_idle_ns_ * ms, gpu_ts_batches_read_, gpu_ts_batches_skipped_);
+  REXGPU_INFO("[gpu-time2] draw pass ms/passes per frame by size:{}", extents);
+  std::fill(std::begin(gpu_ts_ns_), std::end(gpu_ts_ns_), 0.0);
+  std::fill(std::begin(gpu_ts_extent_ns_), std::end(gpu_ts_extent_ns_), 0.0);
+  std::fill(std::begin(gpu_ts_extent_passes_), std::end(gpu_ts_extent_passes_), 0u);
+  gpu_ts_idle_ns_ = 0.0;
+  gpu_ts_batches_read_ = 0;
+  gpu_ts_batches_skipped_ = 0;
+}
+
