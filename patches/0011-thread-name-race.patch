From b0486bc22ed8ebece76d164e7b98ee441717fa62 Mon Sep 17 00:00:00 2001
From: UAW Recomp <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 18:13:50 -0400
Subject: [PATCH] threading: fix thread-name data race at XThread start (double
 free)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 include/rex/thread.h   | 11 +++++++++--
 src/system/xthread.cpp | 12 +++++++++---
 2 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/include/rex/thread.h b/include/rex/thread.h
index 30b207d..7026431 100644
--- a/include/rex/thread.h
+++ b/include/rex/thread.h
@@ -415,10 +415,16 @@ class Thread : public WaitHandle {
   virtual uint32_t system_id() const = 0;
 
   // Returns the current name of the thread, if previously specified.
-  const std::string& name() const { return name_; }
+  std::string name() const {
+    std::lock_guard<std::mutex> lock(name_mutex_);
+    return name_;
+  }
 
   // Sets the name of the thread, used in debugging and logging.
-  virtual void set_name(std::string name) { name_ = std::move(name); }
+  virtual void set_name(std::string name) {
+    std::lock_guard<std::mutex> lock(name_mutex_);
+    name_ = std::move(name);
+  }
 
   // Returns the current priority value for the thread.
   virtual int32_t priority() = 0;
@@ -460,6 +466,7 @@ class Thread : public WaitHandle {
 
  protected:
   std::string name_;
+  mutable std::mutex name_mutex_;
 };
 
 }  // namespace rex::thread
diff --git a/src/system/xthread.cpp b/src/system/xthread.cpp
index 77bce25..83c3da0 100644
--- a/src/system/xthread.cpp
+++ b/src/system/xthread.cpp
@@ -439,10 +439,16 @@ X_STATUS XThread::Create() {
     // Set thread ID override. This is used by logging.
     rex::thread::set_current_thread_id(handle());
 
-    // Set name immediately, if we have one.
-    thread_->set_name(thread_name_);
+    // Set name immediately, if we have one. Copy it under the lock: the
+    // creating thread may be renaming this thread at the same moment.
+    std::string start_name;
+    {
+      std::lock_guard<std::mutex> name_lock(thread_lock_);
+      start_name = thread_name_;
+    }
+    thread_->set_name(start_name);
 
-    PROFILE_THREAD_ENTER(thread_name_.c_str());
+    PROFILE_THREAD_ENTER(start_name.c_str());
     PROFILE_THREAD_CREATED();
 
     // Execute user code.
-- 
